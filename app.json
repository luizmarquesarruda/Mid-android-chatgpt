{
  "expo": {
    "name": "MERIVA MID ANDROID",
    "slug": "mid-android-chatgpt",
    "scheme": "mid-android-chatgpt",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": ["android"],
    "android": {
      "package": "com.meriva.midandroidchatgpt",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "assetBundlePatterns": ["**/*"],
    "experiments": { "typedRoutes": true, "tsconfigPaths": true }
  }
}